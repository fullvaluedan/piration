# Copy to .env.publish (gitignored) and fill in.
# Never commit real keys.

# Open Cloud API key from https://create.roblox.com/dashboard/credentials
# Permissions needed:
#   universe-places:write  (or Place Publishing)
#   (optional) universe.place:write depending on key UI labels
ROBLOX_API_KEY=

# From Creator Dashboard → your experience
# URL looks like:
#   https://create.roblox.com/dashboard/creations/experiences/<UNIVERSE_ID>/...
ROBLOX_UNIVERSE_ID=

# Place ID = the number in roblox.com/games/<PLACE_ID>/...
ROBLOX_PLACE_ID=
